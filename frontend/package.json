{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contractor Plus desktop client (Electron shell over the Vue SPA).",
  "author": "Contractor Plus",
  "main": "electron/main/main.js",
  "scripts": {
    "//dev": "----- Vite dev servers (mode-switched) -----",
    "dev": "cross-env VITE_TARGET=electron CONTRACTOR_APP_MODE=server vite",
    "dev:web": "cross-env VITE_TARGET=web CONTRACTOR_APP_MODE=server vite",
    "dev:client": "cross-env VITE_TARGET=electron CONTRACTOR_APP_MODE=client vite",

    "//build": "----- Vite production builds (mode-switched) -----",
    "build": "vue-tsc -b && cross-env VITE_TARGET=electron CONTRACTOR_APP_MODE=server vite build",
    "build:web": "vue-tsc -b && cross-env VITE_TARGET=web CONTRACTOR_APP_MODE=server vite build",
    "build:client": "vue-tsc -b && cross-env VITE_TARGET=electron CONTRACTOR_APP_MODE=client vite build",

    "//electron": "----- Electron shell (mode-switched) -----",
    "electron:dev": "cross-env CONTRACTOR_APP_MODE=server electron .",
    "electron:dev:client": "cross-env CONTRACTOR_APP_MODE=client electron .",

    "//misc": "----- Misc -----",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icons:gen": "node scripts/gen-mdi-icons.mjs"
  },
  "dependencies": {
    "@contractor-plus/shared": "workspace:*",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@mdi/js": "^7",
    "@vueuse/core": "^11.2.0",
    "apexcharts": "^5.15.2",
    "axios": "^1.7.7",
    "electron-updater": "^6.3.9",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.11.1",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@contractor-plus/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "sass": "^1.81.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-vue-devtools": "7.7.9",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-tsc": "^2.1.10"
  }
}
