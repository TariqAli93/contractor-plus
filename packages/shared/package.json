{
  "name": "@contractor-plus/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service-config": {
      "types": "./dist/service/config.d.ts",
      "import": "./dist/service/config.js",
      "default": "./dist/service/config.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "service-config": ["./dist/service/config.d.ts"]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@contractor-plus/tsconfig": "workspace:*",
    "typescript": "^5.6.3"
  }
}
