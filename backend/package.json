{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/change-orders/change-orders.test.ts test/ai-command/ai-command.test.ts test/estimation-templates/estimation-templates.test.ts test/ai-platform/ai-platform.test.ts test/ai-models/openrouter-models.test.ts test/rate-limit/rate-limit.test.ts test/crypto/crypto.test.ts test/llm/circuit-breaker.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/ai-command/ai-command.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@contractor-plus/shared": "workspace:*",
    "@fastify/cookie": "^9",
    "@fastify/cors": "^9.0.1",
    "@fastify/csrf-protection": "^6",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "docxtemplater": "^3.50.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pizzip": "^3.1.7",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@contractor-plus/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
