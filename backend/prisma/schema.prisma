// ============================================================
// Contractor Management System — Prisma Schema (MVP)
// PostgreSQL + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

// Role names are no longer a DB enum — roles may be system (OWNER, ADMIN, …)
// or custom. The canonical system-role name constants live in
// @contractor-plus/shared (RoleName). `Role.name` is a free String + unique.

enum ContractStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  OTHER
}

enum ConstructionStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CostCategory {
  MATERIAL
  LABOR
  MACHINERY
  TRANSPORT
  MISC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum CurrencySymbolPosition {
  BEFORE
  AFTER
}

// Phase 3 — DOCX templates the renderer consumes. CONTRACT is the only
// generator wired today; the other categories are reserved so Phase 4 can
// add quotations/invoices/reports without a schema migration.
enum DocumentCategory {
  CONTRACT
  QUOTATION
  INVOICE
  REPORT
}

// ============================================================
// Auth & RBAC
// ============================================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  // System role names match @contractor-plus/shared RoleName; custom roles use
  // any other unique string.
  name        String           @unique
  displayName String?
  description String?
  sortOrder   Int              @default(0)
  isSystem    Boolean          @default(true)
  // Protected roles cannot be deleted (all system roles are protected; OWNER
  // additionally can never lose effective full access).
  isProtected Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// ============================================================
// RBAC — dynamic permissions
// ============================================================

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  // Stable string identifier, e.g. "customers.create". Never generated.
  key         String           @unique
  module      String
  action      String
  displayName String
  description String?
  sortOrder   Int              @default(0)
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  // Login identifier. Stored lowercase-normalized; uniqueness enforced here.
  username      String         @unique
  // Contact info — optional, no longer the login identifier. Unique index
  // treats NULLs as distinct, so multiple users may have no email.
  email         String?        @unique
  passwordHash  String
  fullName      String
  phone         String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  roleId        String         @db.Uuid
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  aiCommands    AiCommandLog[]
  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreator")
  documentsGenerated       GeneratedDocument[] @relation("GeneratedDocumentCreator")
  estimationDrafts    EstimationTemplateDraft[]
  estimationAuditLogs EstimationAuditLog[]
  aiSessions          AiSession[]
  aiExecutions        AiExecution[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  revokedByIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// ============================================================
// Customers
// ============================================================

model Customer {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  contracts Contract[]
  generatedDocuments GeneratedDocument[] @relation("GeneratedFromCustomer")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

// ============================================================
// Materials (referenced by contract_items & template_items)
// ============================================================

model Material {
  id            String                 @id @default(uuid()) @db.Uuid
  name          String
  unit          String
  defaultPrice  Decimal?               @db.Decimal(14, 2)
  notes         String?
  isActive      Boolean                @default(true)
  contractItems ContractItem[]
  templateItems BuildingTemplateItem[]
  projectCosts  ProjectCost[]
  estimationTemplateItems EstimationTemplateItem[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("materials")
}

// ============================================================
// Building Templates
// ============================================================

model BuildingTemplate {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  estimatedDurationDays Int?
  suggestedProfitMargin Decimal?               @db.Decimal(5, 2)
  isActive              Boolean                @default(true)
  items                 BuildingTemplateItem[]
  steps                 BuildingTemplateStep[]
  contracts             Contract[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("building_templates")
}

model BuildingTemplateItem {
  id                String           @id @default(uuid()) @db.Uuid
  templateId        String           @db.Uuid
  template          BuildingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  materialId        String           @db.Uuid
  material          Material         @relation(fields: [materialId], references: [id])
  quantityFormula   String
  estimatedQuantity Decimal          @db.Decimal(14, 3)
  estimatedPrice    Decimal          @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([templateId])
  @@index([materialId])
  @@map("building_template_items")
}

model BuildingTemplateStep {
  id            String           @id @default(uuid()) @db.Uuid
  templateId    String           @db.Uuid
  template      BuildingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  percentage    Decimal          @db.Decimal(5, 2)
  sortOrder     Int
  estimatedDays Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@map("building_template_steps")
}

// ============================================================
// Contracts
// ============================================================

model Contract {
  id                   String            @id @default(uuid()) @db.Uuid
  contractNumber       String            @unique
  customerId           String            @db.Uuid
  customer             Customer          @relation(fields: [customerId], references: [id])
  templateId           String?           @db.Uuid
  template             BuildingTemplate? @relation(fields: [templateId], references: [id])
  buildingArea         Decimal           @db.Decimal(10, 2)
  floors               Int               @default(1)
  meterPrice           Decimal           @db.Decimal(14, 2)
  totalPrice           Decimal           @db.Decimal(14, 2)
  expectedProfitMargin Decimal?          @db.Decimal(5, 2)
  status               ContractStatus    @default(DRAFT)
  signedAt             DateTime?
  notes                String?
  items                ContractItem[]
  project              Project?
  generatedDocuments   GeneratedDocument[] @relation("GeneratedFromContract")
  changeOrders         ChangeOrder[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  @@index([customerId])
  @@index([templateId])
  @@index([status])
  @@index([deletedAt])
  @@map("contracts")
}

model ContractItem {
  id             String   @id @default(uuid()) @db.Uuid
  contractId     String   @db.Uuid
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialId     String   @db.Uuid
  material       Material @relation(fields: [materialId], references: [id])
  quantity       Decimal  @db.Decimal(14, 3)
  unit           String
  estimatedPrice Decimal  @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contractId])
  @@index([materialId])
  @@map("contract_items")
}

// A formal amendment to an APPROVED contract: a signed `amount` delta (positive
// = addition, negative = deduction). Approved change orders shift the contract's
// revised total; to reverse one you issue a new (negative) order. Sequential
// `number` per contract. DRAFT → APPROVED | REJECTED (terminal).
model ChangeOrder {
  id          String            @id @default(uuid()) @db.Uuid
  contractId  String            @db.Uuid
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?
  amount      Decimal           @db.Decimal(14, 2)
  status      ChangeOrderStatus @default(DRAFT)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@unique([contractId, number])
  @@index([contractId])
  @@index([status])
  @@map("change_orders")
}

// ============================================================
// Projects
// ============================================================

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  contractId         String?            @unique @db.Uuid
  contract           Contract?          @relation(fields: [contractId], references: [id])
  name               String
  startDate          DateTime?
  deliveryDate       DateTime?
  progressPercentage Decimal            @default(0) @db.Decimal(5, 2)
  status             ProjectStatus      @default(PLANNED)
  notes              String?
  costs              ProjectCost[]
  payments           Payment[]
  steps              ConstructionStep[]
  generatedDocuments GeneratedDocument[] @relation("GeneratedFromProject")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([status])
  @@index([startDate])
  @@index([deliveryDate])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectCost {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  materialId  String?      @db.Uuid
  material    Material?    @relation(fields: [materialId], references: [id])
  description String
  quantity    Decimal?     @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal?     @db.Decimal(14, 2)
  totalAmount Decimal      @db.Decimal(14, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([category])
  @@index([materialId])
  @@index([date])
  @@index([deletedAt])
  @@map("project_costs")
}

model Payment {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(14, 2)
  dueDate     DateTime
  paymentDate DateTime?
  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("payments")
}

model ConstructionStep {
  id          String                 @id @default(uuid()) @db.Uuid
  projectId   String                 @db.Uuid
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  percentage  Decimal                @db.Decimal(5, 2)
  sortOrder   Int                    @default(0)
  status      ConstructionStepStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([projectId, sortOrder])
  @@map("construction_steps")
}

// ============================================================
// Tunnel — singleton row. Holds only the bits the local agent needs
// to display status; cloudflared credentials live on disk, the
// management server owns the rest.
// ============================================================

model TunnelState {
  id        String   @id @default(uuid()) @db.Uuid
  enabled   Boolean  @default(false)
  subdomain String?
  publicUrl String?
  tunnelId  String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tunnel_state")
}

// ============================================================
// System Settings (Phase 1) — small, typed surface for org-wide
// configuration. Three storage shapes:
//   - SystemSetting:   typed key/value bag for misc General toggles.
//   - Currency:        catalog of currencies with one default at a time.
//   - CompanyProfile:  singleton row (id = "default") with org details.
// Money values stored on existing rows are NOT touched by changing the
// default currency — currency affects DISPLAY formatting only.
// ============================================================

model SystemSetting {
  // Free-form key — module-prefixed (e.g. "general.fiscalYearStart").
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Currency {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique // ISO-ish, e.g. "USD", "SAR" — uppercased on write
  name              String                 // e.g. "US Dollar"
  symbol            String                 // e.g. "$", "ر.س"
  symbolPosition    CurrencySymbolPosition @default(BEFORE)
  decimalPrecision  Int                    @default(2)
  thousandSeparator String                 @default(",")
  decimalSeparator  String                 @default(".")
  isActive          Boolean                @default(true)
  isDefault         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Partial unique: at most ONE row may have isDefault = true. Postgres
  // honours unique constraints over (isDefault) WHERE isDefault = true via
  // a partial unique index — Prisma can't express partials yet, so we
  // create it manually in the migration. The plain index here keeps
  // lookups fast; the partial index is layered on top.
  @@index([isDefault])
  @@index([isActive])
  @@map("currencies")
}

model CompanyProfile {
  // Singleton — we hard-code id = "default" and refuse extra rows in code.
  id                 String   @id @default("default")
  companyName        String   @default("")
  legalName          String?
  email              String?
  phone              String?
  address            String?
  taxNumber          String?
  registrationNumber String?
  website            String?
  footerText         String?
  notes              String?
  // Asset references — files live on disk under the storage root, we only
  // persist the relative path + validated mime type. Binary blobs are NEVER
  // stored in the database.
  logoPath           String?
  logoMimeType       String?
  stampPath          String?
  stampMimeType      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_profile")
}

// ============================================================
// Document templates (Phase 3) — uploaded .docx files used by the
// generation pipeline to produce contracts/quotations/invoices/reports.
//
// Storage: files live under <storage-root>/private/templates/<uuid>.docx
// and are never served via the public static mount. The `filePath` column
// holds the relative path inside the private storage tree.
//
// `placeholdersJson` is a redundant cache of the {{tokens}} we extracted
// during upload — purely informational; the renderer reads tokens straight
// from the file each time it runs.
// ============================================================

model DocumentTemplate {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  slug             String              @unique
  category         DocumentCategory
  description      String?
  filePath         String
  mimeType         String
  isActive         Boolean             @default(true)
  isDefault        Boolean             @default(false)
  placeholdersJson Json?
  createdBy        String?             @db.Uuid
  createdByUser    User?               @relation("DocumentTemplateCreator", fields: [createdBy], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  generations      GeneratedDocument[]

  @@index([category])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("document_templates")
}

// One generated artefact per render. Immutable — no soft delete column.
// The on-disk file lives under <storage-root>/private/contracts/<uuid>.docx
// (or another private bucket once non-contract generation is wired).
model GeneratedDocument {
  id           String           @id @default(uuid()) @db.Uuid
  templateId   String           @db.Uuid
  template     DocumentTemplate @relation(fields: [templateId], references: [id])
  contractId   String?          @db.Uuid
  contract     Contract?        @relation("GeneratedFromContract", fields: [contractId], references: [id])
  projectId    String?          @db.Uuid
  project      Project?         @relation("GeneratedFromProject", fields: [projectId], references: [id])
  customerId   String?          @db.Uuid
  customer     Customer?        @relation("GeneratedFromCustomer", fields: [customerId], references: [id])
  filename     String
  filePath     String
  mimeType     String
  size         Int
  generatedBy  String?          @db.Uuid
  generatedByUser User?         @relation("GeneratedDocumentCreator", fields: [generatedBy], references: [id])
  createdAt    DateTime         @default(now())

  @@index([templateId])
  @@index([contractId])
  @@index([projectId])
  @@index([customerId])
  @@index([createdAt])
  @@map("generated_documents")
}

// ============================================================
// Audit Logs (immutable — no soft delete)
// ============================================================

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// AI Command Workflow System
//
// Every /interpret, /confirm, and /cancel turn is recorded as one immutable
// AiCommandLog row — the raw command text, the detected intent + confidence,
// the AI-proposed plan, the confirmation status, which actions executed, the
// created/updated entity ids, and any failure reason. Sessions themselves are
// short-lived and live in-memory (a pending plan awaiting confirmation); only
// this durable audit trail is persisted.
// ============================================================

model AiCommandLog {
  id                 String   @id @default(uuid()) @db.Uuid
  // Acting user — required: every audit path threads a real principal. Users are
  // soft-deleted (deletedAt), so a required FK never blocks a real deletion.
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id])
  sessionId          String?  @db.Uuid
  // Raw user command text (as typed).
  originalText       String
  // Interpretation output.
  detectedIntent     String?
  confidence         Float?
  // One of: workflow_plan | clarification | query | execution | rejected.
  resultKind         String
  // The full plan the AI proposed (ordered steps), for transparency/replay.
  generatedPlan      Json?
  // pending | confirmed | cancelled | executed | failed | not_required.
  confirmationStatus String?
  // Outcome details.
  executedActions    Json?
  createdEntityIds   Json?
  updatedEntityIds   Json?
  failedReason       String?
  // AI gateway that answered — always "openrouter" now (kept as a string for
  // historical rows written under the former multi-provider system).
  provider           String?
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([resultKind])
  @@index([createdAt])
  @@map("ai_command_logs")
}

// ============================================================
// AI Smart Estimation Template Builder
//
// Two real domain tables (EstimationTemplate + EstimationTemplateItem) that only
// receive rows at FINAL CONFIRM, plus one durable draft table
// (EstimationTemplateDraft) holding the entire in-progress AI session state so a
// draft survives a server restart and is fully auditable — unlike
// ai-command-workflow's Session, which is deliberately in-memory/short-lived. A
// dedicated EstimationAuditLog gives this feature its own narrative trail
// (command → parsed intent → generated estimation → materials resolution →
// approval → executed actions), alongside the generic AuditLog rows every
// mutation already writes via AuditService.log().
// ============================================================

enum EstimationDraftStatus {
  DRAFT_GENERATED        // LLM produced a first draft
  CLARIFICATION_NEEDED   // missing required info — waiting on the user
  MATERIALS_PENDING      // 1+ items awaiting a create/skip decision
  READY_FOR_CONFIRMATION // every item resolved — preview can be shown
  CONFIRMED              // final transaction succeeded
  CANCELLED              // user explicitly cancelled
  EXPIRED                // aged out (lazy-expiry-on-read)
  FAILED                 // final-confirm transaction failed and rolled back
}

enum EstimationMaterialResolutionStatus {
  MATCHED           // existing Material found and linked
  PENDING_APPROVAL  // no match — asking "create this material?"
  APPROVED_CREATE   // user approved — created only at final confirm
  SKIPPED           // user declined — stays unresolved (materialId null forever)
}

// Durable, DB-backed in-progress AI session state for ONE estimation-builder
// conversation. Persisted (unlike ai-command-workflow's in-memory Session)
// because this workflow is multi-step / longer-running and must be auditable and
// resumable across a server restart.
model EstimationTemplateDraft {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  user             User                  @relation(fields: [userId], references: [id])
  status           EstimationDraftStatus @default(DRAFT_GENERATED)

  originalCommand  String                // raw NL text as typed
  clarificationLog Json?                 // ordered [{question, answer}] pairs

  projectType      String?               // free text, advisory only
  constructionType String?
  scopeOfWork      String?
  areaValue        Decimal?              @db.Decimal(14, 3)
  areaUnit         String?               // "m2" | "m" | ...
  wastePercentage  Decimal               @default(0) @db.Decimal(5, 2)

  templateName     String?               // proposed name, editable before confirm
  confidence       Float                 @default(0) // AI confidence 0..1 for this draft
  generatedItems   Json                  // EstimationDraftItemPayload[]
  estimatedTotal   Decimal               @default(0) @db.Decimal(14, 2)

  expiresAt        DateTime              // lazy-expiry-on-read cutoff
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  resultTemplateId String?               @unique @db.Uuid
  resultTemplate   EstimationTemplate?   @relation(fields: [resultTemplateId], references: [id])

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  auditLogs        EstimationAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("estimation_template_drafts")
}

// The real, confirmed template — rows only ever created inside confirmDraft()'s
// transaction. isPreliminary is always true in v1; kept as a field so a future
// "promote to reviewed" action has somewhere to flip it without a migration.
model EstimationTemplate {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  projectType      String?
  constructionType String?
  scopeOfWork      String?
  areaValue        Decimal?                 @db.Decimal(14, 3)
  areaUnit         String?
  wastePercentage  Decimal                  @default(0) @db.Decimal(5, 2)
  estimatedTotal   Decimal                  @db.Decimal(14, 2)
  isPreliminary    Boolean                  @default(true)
  notes            String?
  items            EstimationTemplateItem[]
  sourceDraft      EstimationTemplateDraft? // inverse of the @unique resultTemplateId — truly 1:1
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  @@index([name])
  @@index([deletedAt])
  @@map("estimation_templates")
}

// Mirrors ProjectCost's shape (nullable materialId + category + optional
// quantity/unit/unitPrice + required total), not BuildingTemplateItem's.
model EstimationTemplateItem {
  id          String             @id @default(uuid()) @db.Uuid
  templateId  String             @db.Uuid
  template    EstimationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    CostCategory
  materialId  String?            @db.Uuid
  material    Material?          @relation(fields: [materialId], references: [id])
  description String
  quantity    Decimal?           @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal?           @db.Decimal(14, 2)
  totalAmount Decimal            @db.Decimal(14, 2)
  sortOrder   Int                @default(0)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([templateId])
  @@index([materialId])
  @@index([category])
  @@map("estimation_template_items")
}

// Dedicated narrative audit trail for this feature. Immutable, no deletedAt —
// same convention as AuditLog / AiCommandLog. One row per key state transition:
// draft_generated | materials_resolved | confirmed | cancelled | failed.
model EstimationAuditLog {
  id                    String                  @id @default(uuid()) @db.Uuid
  draftId               String                  @db.Uuid
  draft                 EstimationTemplateDraft @relation(fields: [draftId], references: [id])
  userId                String?                 @db.Uuid
  user                  User?                   @relation(fields: [userId], references: [id])
  eventType             String
  originalCommand       String
  parsedIntent          Json?
  generatedEstimation   Json?
  existingMaterialsUsed Json?
  newlyCreatedMaterials Json?
  userApproval          Json?
  executedActions       Json?
  finalSavedValues      Json?
  failedReason          String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                @default(now())

  @@index([draftId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("estimation_audit_logs")
}

// ============================================================
// AI Operating Platform
//
// The shared spine every AI capability flows through. AiSession is the durable,
// resumable, multi-session conversation state (generalizes both the in-memory
// ai-command SessionStore and the durable EstimationTemplateDraft). AiMessage is
// the conversation-memory turn log. AiExecution is the unified narrative audit
// trail (folds forward AiCommandLog + EstimationAuditLog). Tool working state
// lives in AiSession.workingState (tool-namespaced JSON); the real domain rows a
// tool creates still live in that domain's own tables.
// ============================================================

enum AiSessionStatus {
  ACTIVE                 // open; accepting messages
  AWAITING_CONFIRMATION  // a resolved plan is parked, waiting on the user
  COMPLETED              // a plan executed successfully
  CANCELLED              // user cancelled the parked plan / session
  EXPIRED                // aged out (lazy-expiry-on-read)
  FAILED                 // execution failed and rolled back
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Durable, DB-backed platform session. Multiple concurrent sessions per user;
/// resumable across a server restart (unlike the ai-command in-memory store).
model AiSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id])
  title        String?
  status       AiSessionStatus @default(ACTIVE)
  activeTool   String?                            // tool that owns workingState
  workingState Json?                              // tool-scoped draft (e.g. EstimationDraftItemPayload[])
  pendingPlan  Json?                              // resolved Plan awaiting confirm
  contextRefs  Json?                              // resolved existing-record ids (generalizes PlanRefs)
  lastIntent   String?
  confidence   Float           @default(0)
  expiresAt    DateTime                           // lazy-expiry-on-read cutoff
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  messages     AiMessage[]
  executions   AiExecution[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([activeTool])
  @@map("ai_sessions")
}

/// Conversation memory: every turn in a session. Cascades with the session.
model AiMessage {
  id         String        @id @default(uuid()) @db.Uuid
  sessionId  String        @db.Uuid
  session    AiSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       AiMessageRole
  kind       String        // command|clarification|plan|preview|query|execution|rejected
  content    String
  toolName   String?
  intent     Json?
  plan       Json?
  confidence Float?
  createdAt  DateTime      @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_messages")
}

/// Unified platform audit trail — one row per plan execution attempt. Immutable
/// (no deletedAt), matching AuditLog / AiCommandLog / EstimationAuditLog.
model AiExecution {
  id                String     @id @default(uuid()) @db.Uuid
  sessionId         String?    @db.Uuid
  session           AiSession? @relation(fields: [sessionId], references: [id])
  // Acting user — required (see AiCommandLog.userId).
  userId            String     @db.Uuid
  user              User       @relation(fields: [userId], references: [id])
  toolName          String?
  originalRequest   String
  parsedIntent      Json?
  plannerOutput     Json?      // ordered steps
  selectedTools     Json?      // tool/action names
  userApproval      Json?
  executedActions   Json?
  finalData         Json?
  transactionResult String     // executed|failed|cancelled|not_required
  confidence        Float?
  provider          String?
  failedReason      String?
  createdAt         DateTime   @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([toolName])
  @@index([transactionResult])
  @@index([createdAt])
  @@map("ai_executions")
}
