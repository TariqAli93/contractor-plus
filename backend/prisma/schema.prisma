// ============================================================
// Contractor Management System — Prisma Schema (MVP)
// PostgreSQL + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

// Role names are no longer a DB enum — roles may be system (OWNER, ADMIN, …)
// or custom. The canonical system-role name constants live in
// @contractor-plus/shared (RoleName). `Role.name` is a free String + unique.

enum ContractStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  OTHER
}

enum ConstructionStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CostCategory {
  MATERIAL
  LABOR
  MACHINERY
  TRANSPORT
  MISC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum CurrencySymbolPosition {
  BEFORE
  AFTER
}

// Phase 3 — DOCX templates the renderer consumes. CONTRACT is the only
// generator wired today; the other categories are reserved so Phase 4 can
// add quotations/invoices/reports without a schema migration.
enum DocumentCategory {
  CONTRACT
  QUOTATION
  INVOICE
  REPORT
}

// ai-assistant — the operation kinds a request to the AI provider can serve.
// Mirrored in @contractor-plus/shared (AiOperationType) for API payloads.
enum AiOperationType {
  REPORT_NARRATIVE
  DUPLICATE_DETECTION
  SAVE_GUARD
  RECOMMENDATION
  NL_REPORT_QUERY
  MATERIAL_PRICE_SYNC
  CHAT
  TOOL_ACTION
}

// Lifecycle of an AI-proposed write. A tool call is PROPOSED (PENDING), the user
// CONFIRMS it, and only then is it EXECUTED (inside a transaction). REJECTED /
// EXPIRED / FAILED are terminal. Idempotency + status guard against double runs.
enum AiPendingActionStatus {
  PENDING
  CONFIRMED
  EXECUTED
  REJECTED
  EXPIRED
  FAILED
}

// ai-assistant — approval lifecycle of an AI suggestion. NONE for read-only
// operations (narratives, queries); PENDING→APPROVED/REJECTED for suggestions
// that require the explicit apply endpoint.
enum AiApprovalState {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// Auth & RBAC
// ============================================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  // System role names match @contractor-plus/shared RoleName; custom roles use
  // any other unique string.
  name        String           @unique
  displayName String?
  description String?
  sortOrder   Int              @default(0)
  isSystem    Boolean          @default(true)
  // Protected roles cannot be deleted (all system roles are protected; OWNER
  // additionally can never lose effective full access).
  isProtected Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// ============================================================
// RBAC — dynamic permissions
// ============================================================

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  // Stable string identifier, e.g. "customers.create". Never generated.
  key         String           @unique
  module      String
  action      String
  displayName String
  description String?
  sortOrder   Int              @default(0)
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  // Login identifier. Stored lowercase-normalized; uniqueness enforced here.
  username                 String                 @unique
  // Contact info — optional, no longer the login identifier. Unique index
  // treats NULLs as distinct, so multiple users may have no email.
  email                    String?                @unique
  passwordHash             String
  fullName                 String
  phone                    String?
  isActive                 Boolean                @default(true)
  lastLoginAt              DateTime?
  roleId                   String                 @db.Uuid
  role                     Role                   @relation(fields: [roleId], references: [id])
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  aiRequestLogs            AiRequestLog[]
  aiCredentialsCreated     AiProviderCredential[] @relation("AiCredentialCreator")
  aiSettingsUpdated        AiSetting[]            @relation("AiSettingUpdater")
  aiChatThreads            AiChatThread[]         @relation("AiChatThreadOwner")
  aiPendingActions         AiPendingAction[]      @relation("AiPendingActionOwner")
  documentTemplatesCreated DocumentTemplate[]     @relation("DocumentTemplateCreator")
  documentsGenerated       GeneratedDocument[]    @relation("GeneratedDocumentCreator")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  revokedByIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// ============================================================
// Customers
// ============================================================

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  contracts          Contract[]
  generatedDocuments GeneratedDocument[] @relation("GeneratedFromCustomer")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

// ============================================================
// Materials (referenced by contract_items & template_items)
// ============================================================

model Material {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String
  unit            String
  defaultPrice    Decimal?                 @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean                  @default(true)
  contractItems   ContractItem[]
  templateItems   BuildingTemplateItem[]
  projectCosts    ProjectCost[]
  referencePrices MaterialReferencePrice[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("materials")
}

// ============================================================
// Building Templates
// ============================================================

model BuildingTemplate {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  estimatedDurationDays Int?
  suggestedProfitMargin Decimal?               @db.Decimal(5, 2)
  isActive              Boolean                @default(true)
  items                 BuildingTemplateItem[]
  steps                 BuildingTemplateStep[]
  contracts             Contract[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("building_templates")
}

model BuildingTemplateItem {
  id                String           @id @default(uuid()) @db.Uuid
  templateId        String           @db.Uuid
  template          BuildingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  materialId        String           @db.Uuid
  material          Material         @relation(fields: [materialId], references: [id])
  quantityFormula   String
  estimatedQuantity Decimal          @db.Decimal(14, 3)
  estimatedPrice    Decimal          @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([templateId])
  @@index([materialId])
  @@map("building_template_items")
}

model BuildingTemplateStep {
  id            String           @id @default(uuid()) @db.Uuid
  templateId    String           @db.Uuid
  template      BuildingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  percentage    Decimal          @db.Decimal(5, 2)
  sortOrder     Int
  estimatedDays Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@map("building_template_steps")
}

// ============================================================
// Contracts
// ============================================================

model Contract {
  id                   String              @id @default(uuid()) @db.Uuid
  contractNumber       String              @unique
  customerId           String              @db.Uuid
  customer             Customer            @relation(fields: [customerId], references: [id])
  templateId           String?             @db.Uuid
  template             BuildingTemplate?   @relation(fields: [templateId], references: [id])
  buildingArea         Decimal             @db.Decimal(10, 2)
  floors               Int                 @default(1)
  meterPrice           Decimal             @db.Decimal(14, 2)
  totalPrice           Decimal             @db.Decimal(14, 2)
  expectedProfitMargin Decimal?            @db.Decimal(5, 2)
  status               ContractStatus      @default(DRAFT)
  signedAt             DateTime?
  notes                String?
  items                ContractItem[]
  project              Project?
  generatedDocuments   GeneratedDocument[] @relation("GeneratedFromContract")
  changeOrders         ChangeOrder[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  @@index([customerId])
  @@index([templateId])
  @@index([status])
  @@index([deletedAt])
  @@map("contracts")
}

model ContractItem {
  id             String   @id @default(uuid()) @db.Uuid
  contractId     String   @db.Uuid
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  materialId     String   @db.Uuid
  material       Material @relation(fields: [materialId], references: [id])
  quantity       Decimal  @db.Decimal(14, 3)
  unit           String
  estimatedPrice Decimal  @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contractId])
  @@index([materialId])
  @@map("contract_items")
}

// A formal amendment to an APPROVED contract: a signed `amount` delta (positive
// = addition, negative = deduction). Approved change orders shift the contract's
// revised total; to reverse one you issue a new (negative) order. Sequential
// `number` per contract. DRAFT → APPROVED | REJECTED (terminal).
model ChangeOrder {
  id          String            @id @default(uuid()) @db.Uuid
  contractId  String            @db.Uuid
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?
  amount      Decimal           @db.Decimal(14, 2)
  status      ChangeOrderStatus @default(DRAFT)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@unique([contractId, number])
  @@index([contractId])
  @@index([status])
  @@map("change_orders")
}

// ============================================================
// Projects
// ============================================================

model Project {
  id                 String              @id @default(uuid()) @db.Uuid
  contractId         String?             @unique @db.Uuid
  contract           Contract?           @relation(fields: [contractId], references: [id])
  name               String
  startDate          DateTime?
  deliveryDate       DateTime?
  progressPercentage Decimal             @default(0) @db.Decimal(5, 2)
  status             ProjectStatus       @default(PLANNED)
  notes              String?
  costs              ProjectCost[]
  payments           Payment[]
  steps              ConstructionStep[]
  generatedDocuments GeneratedDocument[] @relation("GeneratedFromProject")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([status])
  @@index([startDate])
  @@index([deliveryDate])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectCost {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  materialId  String?      @db.Uuid
  material    Material?    @relation(fields: [materialId], references: [id])
  description String
  quantity    Decimal?     @db.Decimal(14, 3)
  unit        String?
  unitPrice   Decimal?     @db.Decimal(14, 2)
  totalAmount Decimal      @db.Decimal(14, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([category])
  @@index([materialId])
  @@index([date])
  @@index([deletedAt])
  @@map("project_costs")
}

model Payment {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(14, 2)
  dueDate     DateTime
  paymentDate DateTime?
  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  reference   String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("payments")
}

model ConstructionStep {
  id          String                 @id @default(uuid()) @db.Uuid
  projectId   String                 @db.Uuid
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  percentage  Decimal                @db.Decimal(5, 2)
  sortOrder   Int                    @default(0)
  status      ConstructionStepStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([projectId, sortOrder])
  @@map("construction_steps")
}

// ============================================================
// Tunnel — singleton row. Holds only the bits the local agent needs
// to display status; cloudflared credentials live on disk, the
// management server owns the rest.
// ============================================================

model TunnelState {
  id        String   @id @default(uuid()) @db.Uuid
  enabled   Boolean  @default(false)
  subdomain String?
  publicUrl String?
  tunnelId  String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tunnel_state")
}

// ============================================================
// System Settings (Phase 1) — small, typed surface for org-wide
// configuration. Three storage shapes:
//   - SystemSetting:   typed key/value bag for misc General toggles.
//   - Currency:        catalog of currencies with one default at a time.
//   - CompanyProfile:  singleton row (id = "default") with org details.
// Money values stored on existing rows are NOT touched by changing the
// default currency — currency affects DISPLAY formatting only.
// ============================================================

model SystemSetting {
  // Free-form key — module-prefixed (e.g. "general.fiscalYearStart").
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Currency {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique // ISO-ish, e.g. "USD", "SAR" — uppercased on write
  name              String // e.g. "US Dollar"
  symbol            String // e.g. "$", "ر.س"
  symbolPosition    CurrencySymbolPosition @default(BEFORE)
  decimalPrecision  Int                    @default(2)
  thousandSeparator String                 @default(",")
  decimalSeparator  String                 @default(".")
  isActive          Boolean                @default(true)
  isDefault         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Partial unique: at most ONE row may have isDefault = true. Postgres
  // honours unique constraints over (isDefault) WHERE isDefault = true via
  // a partial unique index — Prisma can't express partials yet, so we
  // create it manually in the migration. The plain index here keeps
  // lookups fast; the partial index is layered on top.
  @@index([isDefault])
  @@index([isActive])
  @@map("currencies")
}

model CompanyProfile {
  // Singleton — we hard-code id = "default" and refuse extra rows in code.
  id                 String   @id @default("default")
  companyName        String   @default("")
  legalName          String?
  email              String?
  phone              String?
  address            String?
  taxNumber          String?
  registrationNumber String?
  website            String?
  footerText         String?
  notes              String?
  // Asset references — files live on disk under the storage root, we only
  // persist the relative path + validated mime type. Binary blobs are NEVER
  // stored in the database.
  logoPath           String?
  logoMimeType       String?
  stampPath          String?
  stampMimeType      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_profile")
}

// ============================================================
// Document templates (Phase 3) — uploaded .docx files used by the
// generation pipeline to produce contracts/quotations/invoices/reports.
//
// Storage: files live under <storage-root>/private/templates/<uuid>.docx
// and are never served via the public static mount. The `filePath` column
// holds the relative path inside the private storage tree.
//
// `placeholdersJson` is a redundant cache of the {{tokens}} we extracted
// during upload — purely informational; the renderer reads tokens straight
// from the file each time it runs.
// ============================================================

model DocumentTemplate {
  id               String              @id @default(uuid()) @db.Uuid
  name             String
  slug             String              @unique
  category         DocumentCategory
  description      String?
  filePath         String
  mimeType         String
  isActive         Boolean             @default(true)
  isDefault        Boolean             @default(false)
  placeholdersJson Json?
  createdBy        String?             @db.Uuid
  createdByUser    User?               @relation("DocumentTemplateCreator", fields: [createdBy], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  generations      GeneratedDocument[]

  @@index([category])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("document_templates")
}

// One generated artefact per render. Immutable — no soft delete column.
// The on-disk file lives under <storage-root>/private/contracts/<uuid>.docx
// (or another private bucket once non-contract generation is wired).
model GeneratedDocument {
  id              String           @id @default(uuid()) @db.Uuid
  templateId      String           @db.Uuid
  template        DocumentTemplate @relation(fields: [templateId], references: [id])
  contractId      String?          @db.Uuid
  contract        Contract?        @relation("GeneratedFromContract", fields: [contractId], references: [id])
  projectId       String?          @db.Uuid
  project         Project?         @relation("GeneratedFromProject", fields: [projectId], references: [id])
  customerId      String?          @db.Uuid
  customer        Customer?        @relation("GeneratedFromCustomer", fields: [customerId], references: [id])
  filename        String
  filePath        String
  mimeType        String
  size            Int
  generatedBy     String?          @db.Uuid
  generatedByUser User?            @relation("GeneratedDocumentCreator", fields: [generatedBy], references: [id])
  createdAt       DateTime         @default(now())

  @@index([templateId])
  @@index([contractId])
  @@index([projectId])
  @@index([customerId])
  @@index([createdAt])
  @@map("generated_documents")
}

// ============================================================
// Audit Logs (immutable — no soft delete)
// ============================================================

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// AI Assistant (modules/ai-assistant — accessed ONLY via its repository)
// ============================================================

// External reference prices for materials — append-only history (D4). New
// syncs INSERT a row; nothing is overwritten, so price evolution is queryable.
// Kept separate from Material on purpose: no columns are added there.
model MaterialReferencePrice {
  id                 String   @id @default(uuid()) @db.Uuid
  materialId         String   @db.Uuid
  material           Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  referencePrice     Decimal  @db.Decimal(14, 2)
  // Price is stored in its ORIGINAL currency — never converted before the
  // currency service does so explicitly (binding rule #5).
  referenceCurrency  String
  referenceSource    String
  referenceRegion    String?
  // When the SOURCE last updated the price (distinct from createdAt = when we
  // fetched it) — shown in the UI so offline staleness is visible.
  referenceUpdatedAt DateTime
  createdAt          DateTime @default(now())

  @@index([materialId, referenceUpdatedAt])
  @@map("material_reference_prices")
}

// Governance log of every AI provider call (D5) — SUMMARY ONLY. Deliberately
// has no column for the full prompt or response text: sensitive content and
// whole contracts must never be persisted here (binding rule #4).
model AiRequestLog {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  user             User            @relation(fields: [userId], references: [id])
  operationType    AiOperationType
  // OpenRouter model slug actually used (from env — never hardcoded).
  modelUsed        String
  // Which modules' PUBLIC services fed the context (e.g. ["reports"]).
  sourceModules    String[]
  // Ids of the records involved, for traceability without storing content.
  recordIds        String[]
  tokensPrompt     Int
  tokensCompletion Int
  // USD cost when known; OpenRouter usage only reports tokens in this batch.
  costUsd          Decimal?        @db.Decimal(12, 6)
  outputSummary    String
  approvalState    AiApprovalState @default(NONE)
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([operationType, createdAt])
  @@index([createdAt])
  @@map("ai_request_logs")
}

// Phase 2.5 — the OpenRouter API key ENCRYPTED at rest (AES-256-GCM). Singleton
// (fixed id). DELIBERATELY has NO column for the raw key: only the ciphertext,
// the GCM nonce/tag, and the last 4 chars for masked display. Decryptable only
// with ENCRYPTION_KEY (never in the DB). See lib/crypto/secret-cipher.ts.
model AiProviderCredential {
  id                  String    @id @default("default")
  ciphertext          String
  iv                  String
  authTag             String
  // Last 4 chars of the raw key, for `••••••{lastFour}` display ONLY.
  lastFour            String
  isActive            Boolean   @default(true)
  // Set once a live OpenRouter check confirmed the key before it was stored.
  validatedAt         DateTime?
  // Number of models the key could reach at validation time — drives the
  // "N models available" panel hint without a live call. Null on legacy rows.
  validatedModelCount Int?
  createdById         String?   @db.Uuid
  createdBy           User?     @relation("AiCredentialCreator", fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("ai_provider_credentials")
}

// Phase 2.5 — AI control-panel settings singleton. Non-sensitive: master
// switch, per-feature flags, chosen models, monthly token budget, price
// sources. DB values WIN over env/service.json (except the API key). A missing
// row means "all defaults" (system enabled, every feature on, env models).
model AiSetting {
  id                   String   @id @default("default")
  systemEnabled        Boolean  @default(true)
  // { report_narrative: bool, nl_query: bool, save_guard: bool, ... }
  features             Json?
  modelDefault         String?
  modelHeavy           String?
  monthlyTokenBudget   Int?
  materialPriceSources Json?
  updatedById          String?  @db.Uuid
  updatedBy            User?    @relation("AiSettingUpdater", fields: [updatedById], references: [id])
  updatedAt            DateTime @default(now()) @updatedAt

  @@map("ai_settings")
}

// Phase 7 — conversational assistant. A thread belongs to ONE user; the chat
// service scopes every read/write by userId so a thread is only ever visible
// to its owner. Storing the conversation is a user-owned convenience (resume)
// and is distinct from the AiRequestLog governance log, which stays
// content-free (binding rule #4).
model AiChatThread {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation("AiChatThreadOwner", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@map("ai_chat_threads")
}

// One turn in a thread. `role` is user | assistant | tool. `toolCalls`/`toolResult`
// carry the read-only report-query tool round when present (never any mutation).
model AiChatMessage {
  id         String       @id @default(uuid()) @db.Uuid
  threadId   String       @db.Uuid
  thread     AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String
  content    String
  // Structured tool-call metadata for an assistant turn that queried a report.
  toolCalls  Json?
  // The (read-only) report data returned to the model for a tool turn.
  toolResult Json?
  createdAt  DateTime     @default(now())

  @@index([threadId, createdAt])
  @@map("ai_chat_messages")
}

// A write the assistant proposed and is waiting for the user to confirm. The
// tool call NEVER executes off the model's text — only through an explicit
// confirm of THIS row's id, once, before it expires. `argumentsJson` holds the
// validated, normalized arguments (NEVER a secret — e.g. a new user's password
// is supplied at confirm time, never stored). `previewJson` is what the
// confirmation dialog renders. `idempotencyKey` + the status guard make a second
// execution impossible.
model AiPendingAction {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  user           User                  @relation("AiPendingActionOwner", fields: [userId], references: [id], onDelete: Cascade)
  toolName       String
  argumentsJson  Json
  previewJson    Json
  status         AiPendingActionStatus @default(PENDING)
  idempotencyKey String                @unique
  // The id of the record created on EXECUTED (traceability, never content).
  resultRecordId String?
  // App error code on FAILED (never a stack trace or raw DB message).
  errorCode      String?
  expiresAt      DateTime
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
  @@map("ai_pending_actions")
}
