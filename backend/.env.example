NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractor_plus?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Remote-access tunnel agent.
# MANAGEMENT_API_URL — codel-management-api root that provisions/revokes
#   the per-machine Cloudflare tunnel. No API key is sent; the management
#   server identifies this machine by the locally-generated machine id.
# LOCAL_SERVICE_URL — what cloudflared points at. Defaults to
#   http://localhost:${PORT} when unset.
# MANAGEMENT_API_TIMEOUT_MS — timeout for each call to the management API.
MANAGEMENT_API_URL=https://manage.codelapps.com
LOCAL_SERVICE_URL=
MANAGEMENT_API_TIMEOUT_MS=15000

# Uploads.
# UPLOAD_ROOT — absolute or relative path for stored files. Leave empty to
#   use <userDataDir>/uploads (default; works under Electron + standalone).
# MAX_UPLOAD_SIZE_MB — per-file size cap enforced by the multipart parser.
UPLOAD_ROOT=
MAX_UPLOAD_SIZE_MB=5

# AI assistant — OpenRouter is the ONLY provider (no other SDK/endpoint).
# Leave OPENROUTER_API_KEY empty to keep AI features safely disabled.
# Model names are OpenRouter slugs; they change over time — verify against
# openrouter.ai/models before deploying, and NEVER hardcode them in code.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_DEFAULT=anthropic/claude-sonnet-4.6
AI_MODEL_HEAVY=anthropic/claude-opus-4.8
# Optional attribution headers (HTTP-Referer / X-Title on openrouter.ai rankings).
AI_APP_URL=
AI_APP_TITLE=Contractor Plus
AI_REQUEST_TIMEOUT_MS=30000
# Monthly token ceiling for governance; leave empty for unlimited.
AI_MONTHLY_TOKEN_BUDGET=
# Phase 5 — external material-price sources (JSON array). Each source exposes
# a JSON document: {"prices":[{"material":"اسمنت","price":8500,"currency":"IQD","updatedAt":"2026-07-01"}]}.
# Leave empty to keep the price sync as a safe no-op. In production these live
# under the service.json "ai.materialPriceSources" array instead.
# Example: [{"name":"مصدر تجريبي","url":"http://127.0.0.1:8899/prices.json","region":"IQ"}]
AI_MATERIAL_PRICE_SOURCES=
# Scheduled sync cadence in hours (runs inside the backend process, not
# Electron). Leave empty for manual sync only (POST /ai/materials/sync-prices).
AI_MATERIAL_PRICE_SYNC_INTERVAL_HOURS=

# Phase 2.5 — encrypts the OpenRouter key stored in the DB (AES-256-GCM).
# Provide a 32-byte key as 64 hex chars or base64, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty (or <32 bytes) to safely disable DB-key management — the
# OPENROUTER_API_KEY above still works. NEVER commit a real value.
ENCRYPTION_KEY=
