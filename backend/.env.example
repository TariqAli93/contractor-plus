NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractor_plus?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m

# Dedicated key for at-rest secret encryption (e.g. the stored OpenRouter API
# key). Optional but RECOMMENDED — keep it distinct from JWT_ACCESS_SECRET so
# rotating auth doesn't invalidate stored secrets and one leak isn't two.
# When unset, the app falls back to JWT_ACCESS_SECRET and warns at startup.
# Generate with: openssl rand -base64 48   (min 32 chars)
SECRET_ENCRYPTION_KEY=

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Remote-access tunnel agent.
# MANAGEMENT_API_URL — codel-management-api root that provisions/revokes
#   the per-machine Cloudflare tunnel. No API key is sent; the management
#   server identifies this machine by the locally-generated machine id.
# LOCAL_SERVICE_URL — what cloudflared points at. Defaults to
#   http://localhost:${PORT} when unset.
# MANAGEMENT_API_TIMEOUT_MS — timeout for each call to the management API.
MANAGEMENT_API_URL=https://manage.codelapps.com
LOCAL_SERVICE_URL=
MANAGEMENT_API_TIMEOUT_MS=15000

# Uploads.
# UPLOAD_ROOT — absolute or relative path for stored files. Leave empty to
#   use <userDataDir>/uploads (default; works under Electron + standalone).
# MAX_UPLOAD_SIZE_MB — per-file size cap enforced by the multipart parser.
UPLOAD_ROOT=
MAX_UPLOAD_SIZE_MB=5

# AI assistant — OpenRouter is the single AI gateway (https://openrouter.ai).
# These are a DEV convenience only; in production the admin configures the key
# from Settings → AI (stored encrypted, never in plaintext, never sent to the UI).
# The LLM stays DISABLED until enabled with a key. OPENROUTER_SITE_URL /
# OPENROUTER_APP_NAME are optional attribution headers.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Contractor Plus
AI_LLM_TIMEOUT_MS=15000
AI_LLM_MAX_TOKENS=1500
